{
  "firestore": {
    "database": "(default)",
    "location": "eur3",
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      ".git/**",
      ".codex/**",
      "graphify-out/**",
      "**/node_modules/**",
      "AGENTS.md",
      "FIREBASE_SETUP.md",
      "firestore.rules",
      "firestore.indexes.json",
      "firebase deploy --only firestore:rules"
    ]
  }
}
